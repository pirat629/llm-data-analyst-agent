OPENROUTER_API_KEY=replace-with-openrouter-key
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
APP_SECRET_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

DATABASE_URI=postgresql+psycopg://analytics_reader:analytics_reader@localhost:5432/analytics_db
DATABASE_ADMIN_URI=postgresql+psycopg://postgres:postgres@localhost:5432/analytics_db
MILVUS_URI=http://localhost:19530

SQL_ALLOWED_TABLES=users,payments,app_events,support_tickets
SQL_MAX_ROWS=1000
SQL_STATEMENT_TIMEOUT_MS=10000
